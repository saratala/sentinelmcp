# Copy to .env and fill in real values. Never commit .env to git.

# Deployment mode. Set to "production" to enforce the startup preflight —
# the gateway REFUSES to boot if it detects insecure defaults (dev API key,
# wildcard CORS, disabled auth, missing schema-signing secret / Redis password).
SENTINEL_ENVIRONMENT=development

# CORS allowed origins (comma-separated). "*" is rejected in production —
# pin explicit origins, e.g. https://app.example.com,https://admin.example.com
SENTINEL_CORS_ORIGINS=*

# API authentication
SENTINEL_API_KEY=sk-change-me-in-production

# Redis (password enforced — do not leave blank in production)
SENTINEL_REDIS_PASSWORD=change-me-redis-password

# Postgres
SENTINEL_POSTGRES_PASSWORD=change-me-postgres-password

# Allowlist enforcement (set true to block unknown MCP servers)
SENTINEL_ALLOWLIST_ENABLED=false

# Active probe safety. The probe launches real attacks at a caller-supplied
# target, so it requires an explicit "authorized": true attestation per request.
SENTINEL_PROBE_REQUIRE_AUTHORIZATION=true
# Block RFC1918/loopback probe targets. Leave false for in-VPC internal scanning
# (a marketed use case); set true for internet-facing SaaS to prevent SSRF into
# internal infra. Cloud-metadata/link-local targets are ALWAYS blocked.
SENTINEL_PROBE_BLOCK_PRIVATE_TARGETS=false

# Rate limiting. Set the storage URI to your Redis to share limits across
# gateway replicas (required for correct HA rate limiting); empty = per-process.
SENTINEL_RATE_LIMIT_ENABLED=true
SENTINEL_RATE_LIMIT_STORAGE_URI=
# SENTINEL_RATE_LIMIT_DEFAULT=300/minute
# SENTINEL_RATE_LIMIT_PROBE=5/minute

# SIEM integrations (optional)
SENTINEL_SPLUNK_HEC_URL=
SENTINEL_SPLUNK_HEC_TOKEN=
SENTINEL_DATADOG_API_KEY=
SENTINEL_WEBHOOK_URL=

# Slack — paste an Incoming Webhook URL (Settings > Add App > Incoming Webhooks)
# Only HIGH and CRITICAL severity events are forwarded.
SENTINEL_SLACK_WEBHOOK_URL=

# PagerDuty — Events API v2 routing key (Service > Integrations > Add integration > Events API v2)
# Repeated alerts from the same session+threat are de-duplicated automatically.
SENTINEL_PAGERDUTY_ROUTING_KEY=

# OpenTelemetry — leave blank to disable tracing
# Run: docker compose --profile observability up -d  (starts Jaeger on :16686)
SENTINEL_OTEL_ENDPOINT=
SENTINEL_OTEL_SERVICE_NAME=sentinelmcp

# Layer 4 — LLM hybrid analysis (grey-zone risk scores 0.35–0.75)
# Provider: "auto" (Ollama first, Anthropic fallback), "ollama", or "anthropic"
SENTINEL_LLM_ANALYSIS_ENABLED=true
SENTINEL_LLM_PROVIDER=auto

# Ollama (local, free — runs qwen2.5:7b or any installed model)
SENTINEL_OLLAMA_URL=http://localhost:11434
SENTINEL_OLLAMA_MODEL=qwen2.5:7b

# Anthropic (cloud fallback — leave blank for local-only dev)
ANTHROPIC_API_KEY=
# SENTINEL_LLM_ANALYSIS_MODEL=claude-haiku-4-5-20251001

# Grey zone bounds
# SENTINEL_LLM_GREY_ZONE_MIN=0.35
# SENTINEL_LLM_GREY_ZONE_MAX=0.75

# Layer-3 async LLM escalation of grey-zone tool OUTPUTS (opt-in; off by default).
# When on, a clean-but-suspicious output is re-checked by the LLM off the response
# path; a positive verdict trips the circuit breaker for the NEXT call. Adds 0ms to
# the response path. Needs a reachable LLM provider (Ollama or ANTHROPIC_API_KEY).
# SENTINEL_OUTPUT_LLM_ESCALATION=false

# JWT / OAuth — leave blank to use API key only
# HS256 (dev): set SENTINEL_JWT_SECRET to a shared secret
# RS256 (prod): set SENTINEL_JWKS_URL to your OIDC provider's JWKS endpoint
SENTINEL_JWT_ISSUER=
SENTINEL_JWT_AUDIENCE=
SENTINEL_JWT_SECRET=
SENTINEL_JWKS_URL=

# Ollama (for local LLM demo agent)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
